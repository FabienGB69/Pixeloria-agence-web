# Notion API — CRM Pixeloria
# 1. Crée une intégration sur https://www.notion.so/my-integrations
# 2. Copie le "Internal Integration Token" ci-dessous
NOTION_TOKEN=secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 3. Ouvre ta base "Business OS — Fabien" dans Notion
# 4. Copie l'ID de la base (32 chars dans l'URL : notion.so/xxx/<DB_ID>?v=...)
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email transactionnel — Resend
# 5. Crée un compte sur https://resend.com et génère une API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx

# 6. Email de Fabien pour recevoir les notifications de nouveaux leads
OWNER_EMAIL=contact@pixeloria.fr

# 7. Dans Vercel : Settings > Environment Variables > ajoute toutes les variables ci-dessus
# 8. La base Notion doit avoir ces propriétés :
#    - Nom (title)
#    - Email (email)
#    - Téléphone (phone_number)
#    - Site web (url)
#    - Offre (select) : "One-Shot 490€ TTC" | "Maintenance 49€/mois"
#    - Statut (select) : "Nouveau" | "En cours" | "Gagné" | "Perdu"
#    - Visiteurs/mois (number)
#    - Leads/mois (number)
#    - Problèmes (multi_select)
#    - Objectifs (multi_select)
#    - Message (rich_text)
#    - Date (date)
#    - Source (select) : "Tunnel refonte" | "Contact direct"

# Avis Google — Places API (New)
# 9. Active "Places API (New)" sur https://console.cloud.google.com/apis/library
# 10. Crée une clé API et restreins-la à l'API "Places API (New)" (Credentials > Restrict Key)
GOOGLE_PLACES_API_KEY=

# 11. Trouve le Place ID de la fiche Pixeloria via https://developers.google.com/maps/documentation/places/web-service/place-id
GOOGLE_PLACE_ID=

# 12. Durée du cache serveur en minutes avant de re-fetcher Google (défaut : 60)
GOOGLE_REVIEWS_CACHE_MINUTES=60
