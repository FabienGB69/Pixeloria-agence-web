{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(python3 -m http.server *)",
      "Bash(node --check *)",
      "Bash(npx html-validate *)",
      "Bash(npx stylelint *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)"
    ]
  },
  "env": {
    "PIXELORIA_BRANCH_STRATEGY": "feature-first",
    "PIXELORIA_DEFAULT_PORT": "8080"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_response.filePath // .tool_input.file_path') && python3 \"$PWD/.claude/fix-curly-quotes.py\" \"$FILE\" 2>/dev/null || true",
            "timeout": 10,
            "statusMessage": "Checking for curly quote corruption..."
          }
        ]
      }
    ]
  }
}
