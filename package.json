{
  "name": "pixeloria-agence-web",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "description": "Pixeloria – Agence Web (Next.js 14 App Router)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:css": "stylelint \"**/*.css\" --ignore-pattern=\".next/**\"",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:a11y": "playwright test --config=playwright.a11y.config.js",
    "ci": "npm run typecheck && npm run lint && npm run build",
    "stripe:create-referral-links": "tsx scripts/create-stripe-referral-links.ts",
    "notion:setup-referrals-db": "tsx scripts/setup-notion-db.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@notionhq/client": "^5.22.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "resend": "^4.0.0",
    "stripe": "^22.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.2",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.25",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.3",
    "stylelint": "^16.10.0",
    "stylelint-config-standard": "^36.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vitest": "^4.1.4"
  }
}
