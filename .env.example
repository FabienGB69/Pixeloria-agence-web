# Stripe API Configuration
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Stripe Webhook Secret
# Create a webhook endpoint in Stripe Dashboard → Developers → Webhooks
# Listen for: checkout.session.completed, invoice.paid
# Endpoint URL: https://pixeloria.fr/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Payment Links for Referral Program
# Generated via: npm run stripe:create-referral-links (see Stripe Dashboard → Payment Links)
NEXT_PUBLIC_STRIPE_SITE_VITRINE_PAYMENT_LINK=https://buy.stripe.com/...
NEXT_PUBLIC_STRIPE_OPTION_VISIBILITE_PAYMENT_LINK=https://buy.stripe.com/...

# Stripe Webhook Redirect URL (for success page after payment)
STRIPE_REDIRECT_URL=https://pixeloria.fr/merci

# Notion API Configuration
# Create a Notion integration at https://www.notion.so/my-integrations
# Share your target page with the integration before running setup
NOTION_TOKEN=secret_...
# ID of the parent Notion page where the database will be created
# Found in the Notion page URL: notion.so/Your-Page-<NOTION_PARENT_PAGE_ID>
NOTION_PARENT_PAGE_ID=...
# Filled automatically after running: npm run notion:setup-referrals-db
NOTION_REFERRALS_DATABASE_ID=...

# Referral Program URLs
NEXT_PUBLIC_REFERRAL_URL=https://pixeloria.fr/parrainage

# Google Tag Manager (optional)
NEXT_PUBLIC_GTM_ID=GTM-...

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-...

# Notion — leads & testimonials databases
NOTION_DB_ID=...
NOTION_TESTIMONIALS_DB_ID=...

# Resend (transactional email)
RESEND_API_KEY=re_...
OWNER_EMAIL=contact@pixeloria.fr

# Cloudflare Turnstile (bot protection on forms)
CLOUDFLARE_TURNSTILE_SECRET_KEY=0x...
NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY=0x...

# CORS — allowed origin for /api/* routes (defaults to https://pixeloria.fr if unset)
ALLOWED_ORIGIN=https://pixeloria.fr

# Upstash Redis (API rate limiting — falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=https://...upstash.io
UPSTASH_REDIS_REST_TOKEN=...

# Google Places (Google Reviews widget)
GOOGLE_PLACES_API_KEY=...
GOOGLE_PLACE_ID=...
GOOGLE_REVIEWS_CACHE_MINUTES=60
