{
  "model": "claude-sonnet-4-6",
  "permissions": {
    "allow": [
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git pull *)",
      "Bash(git fetch *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(python3 -m http.server *)",
      "Bash(node --check *)",
      "Bash(npx html-validate *)",
      "Bash(npx stylelint *)",
      "Bash(ls *)",
      "Bash(mkdir *)",
      "Bash(cat *)"
    ]
  },
  "env": {
    "PIXELORIA_BRANCH_STRATEGY": "feature-first",
    "PIXELORIA_DEFAULT_PORT": "8080"
  }
}
